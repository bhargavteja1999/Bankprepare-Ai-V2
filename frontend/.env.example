# Local development (default when VITE_API_URL is not set):
# VITE_API_URL=http://localhost:8000
#
# Production (Vercel → Render backend, bare host — `/api/v1` is appended automatically):
# VITE_API_URL=https://bankprepare-ai-v2.onrender.com
#
# Legacy alias (still supported, takes effect only if VITE_API_URL is unset):
# VITE_API_BASE_URL=http://localhost:8000/api/v1
