# Backend Environment Variables
PROJECT_NAME=BankPrepare AI
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-super-secret-jwt-key-min-32-chars-long-12345
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./bankprepare.db

# Optional Google Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# CORS Allowed Origins
# Local dev defaults are in app/core/config.py. In production (Render),
# set FRONTEND_URL to your exact Vercel app URL (no trailing slash) so the
# browser allows API calls. Do NOT use "*" with credentials.
# FRONTEND_URL=https://your-app.vercel.app
# Optionally extend instead: CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Upload Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15
